# ═══════════════════════════════════════════════════════════════════════════
#                        QuizGen Bot Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Instructions:
# 1. Rename this file to '.env'
# 2. Replace all placeholder values with your actual configuration
# 3. Make sure not to share your .env file with anyone
# 4. Session files (*.session) are automatically ignored by git
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════
#              API KEYS & TOKENS (REQUIRED)
# ═══════════════════════════════════════════════

# Your Telegram Bot Token (Required)
# Get this from @BotFather on Telegram
# Example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=your_bot_token_here

# Your Google Gemini API Key (Required - Primary Key)
# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
# Example: AIzaSyA1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q
GEMINI_API_KEY=your_gemini_api_key_here

# Additional Gemini API Keys (Optional - For Multi-Key Support & Rotation)
# Comma-separated list of additional API keys for load balancing and failover
# Example: "key1,key2,key3" or use newlines for better readability
# Benefits: Automatic rotation on failures, load balancing, increased rate limits
GEMINI_API_KEYS=your_additional_key_1,your_additional_key_2,your_additional_key_3

# ═══════════════════════════════════════════════
#         PYROGRAM USER ACCOUNT (OPTIONAL)
#         For Large File Downloads (>20MB)
# ═══════════════════════════════════════════════

# Telegram API ID (Optional - Required for files >20MB)
# Get this from https://my.telegram.org/apps
# 1. Log in with your phone number
# 2. Create an application (if needed)
# 3. Copy the api_id (integer) and api_hash (string)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Session String (Optional - Recommended for CI/CD, GitHub Actions)
# Use this instead of interactive authentication for automated deployments
# To generate session string:
# 1. Run: python -c "from pyrogram import Client; print(Client('temp', api_id=YOUR_API_ID, api_hash='YOUR_API_HASH').export_session_string())"
# 2. Or use a script to generate it once, then reuse it
# 3. Keep this secure - it's equivalent to your account password!
# If not set, bot will use interactive authentication (requires phone number input)
# For GitHub Actions/CI: You MUST set this to avoid interactive prompts
TELEGRAM_SESSION_STRING=your_session_string_here

# ═══════════════════════════════════════════════
#            MONGODB CONFIGURATION (REQUIRED)
# ═══════════════════════════════════════════════

# MongoDB Connection URI (Required)
# Get this from your MongoDB Atlas dashboard or local MongoDB instance
# Example: mongodb+srv://username:password@host/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@host/dbname?retryWrites=true&w=majority

# MongoDB Database Name (Required)
# The database where bot settings will be stored
MONGODB_DB=tss_bot

# ═══════════════════════════════════════════════
#            CHANNEL CONFIGURATION (OPTIONAL)
# ═══════════════════════════════════════════════

# Channel ID for Quiz Posts (Optional - Required for Channel Mode)
# To get this ID:
# 1. Forward a message from your channel to @userinfobot
# 2. Look for a number like -1001234567890
# Or use /debug command in the bot
CHANNEL_ID=your_channel_id_here

# Group ID for Forum Topics (Optional - Required for Topic Mode)
# This should be your Telegram forum/group ID
# Must be a supergroup with topics enabled
# To get this ID: Use /debug command in the bot
GROUP_ID=your_forum_group_id_here

# ═══════════════════════════════════════════════
#              QUIZ SETTINGS (OPTIONAL)
# ═══════════════════════════════════════════════

# Quiz Question Prefix (Optional)
# Will be added before each question
# Example: "📝" or "❓" or "[QUIZ]"
# Can be changed later via /db command
QUIZ_MARKER=[Your Quiz Prefix]

# Explanation Feature (Optional)
# Set to "on" to enable explanations, "off" to disable
# Can be changed later via /db command
EXPLANATION_MODE=on

# Quiz Explanation Attribution (Optional)
# Will be added to the end of explanations
# Example: "ℹ️ @YourChannel" or "👉 t.me/YourChannel"
# Can be changed later via /db command
QUIZ_EXPLANATION_LINK=👨‍🏫 t.me/YourChannel

# ═══════════════════════════════════════════════
#             ACCESS CONTROL (REQUIRED)
# ═══════════════════════════════════════════════

# Authorized Users (Required)
# Comma-separated list of Telegram user IDs
# To get user IDs:
# 1. Ask users to send a message to @userinfobot
# 2. They will receive their numeric user ID
# Example: "123456789,987654321,555666777"
# Can be managed later via /db command
AUTHORIZED_USERS=user_id_1,user_id_2,user_id_3

# ═══════════════════════════════════════════════
#         PERFORMANCE & CONCURRENCY (OPTIONAL)
# ═══════════════════════════════════════════════

# Maximum Concurrent Users (Optional)
# Maximum number of users that can process simultaneously
# Default: 100
# Increase for high-traffic scenarios
MAX_CONCURRENT_USERS=100

# Thread Pool Workers (Optional)
# Number of worker threads for CPU-intensive tasks (PDF processing, image conversion)
# Default: 20
# Increase if you have many CPU cores and high load
THREAD_POOL_WORKERS=20

# Connection Pool Size (Optional)
# Number of HTTP connections for Telegram API requests
# Default: 100
# Increase for better concurrent request handling
CONNECTION_POOL_SIZE=100

# Maximum Parallel PDF Pages (Optional)
# Maximum number of PDF pages to process in parallel
# Default: 4
# Increase for faster PDF processing (uses more memory)
MAX_PARALLEL_PAGES=4

# ═══════════════════════════════════════════════
#                LIVE QUIZ (OPTIONAL)
# ═══════════════════════════════════════════════

# Bot username for deep links (without @). Example: MyQuizBot
BOT_USERNAME=your_bot_username_here

# ═══════════════════════════════════════════════
#                    NOTES
# ═══════════════════════════════════════════════
# 
# 1. Most settings can be changed via /db command after initial setup
# 2. Session files (*.session) are automatically created and should be kept secure
# 3. For large file downloads (>20MB), TELEGRAM_API_ID and TELEGRAM_API_HASH are required
# 4. On first run with user account credentials, you'll need to authenticate with phone number
# 5. All optional settings have sensible defaults and can be configured later
# ═══════════════════════════════════════════════
